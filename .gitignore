# ===================================================
# Insurance Portal — .gitignore
# ===================================================

# ===== Maven =====
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ===== IDE =====
.idea/
*.iws
*.iml
*.ipr
.vscode/
*.classpath
*.project
*.settings/

# ===== Sensitive Config (NEVER commit actual secrets) =====
# The real secrets go in application-local.properties (gitignored)
application-local.properties
application-secret.properties

# ===== Spring Boot =====
*.jar
*.war
*.ear
*.nar
/logs/

# ===== OS =====GI
.DS_Store
Thumbs.db

# ===== Environment =====
.env
.env.local
